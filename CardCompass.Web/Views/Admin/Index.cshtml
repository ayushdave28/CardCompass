@model List<CardCompass.Web.Models.Entities.CreditCard>
@{
    ViewData["Title"] = "Admin Management Console";
}

<div class="bg-dark text-white py-4 border-bottom mb-4" style="background: linear-gradient(135deg, #0A192F 0%, #152A4A 100%);">
    <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <span class="badge bg-danger px-3 py-1 mb-2"><i class="bi bi-shield-lock-fill me-1"></i> Admin Console</span>
                <h1 class="h3 fw-bold mb-1">CardCompass Catalog Management</h1>
                <p class="text-white-50 small mb-0">Manage 30 researched credit cards, fees, banks, and incoming user inquiries</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="CreateCard" class="btn btn-sm btn-cc-primary">
                    <i class="bi bi-plus-lg me-1"></i> New Card
                </a>
                <a asp-action="Banks" class="btn btn-sm btn-outline-light">
                    <i class="bi bi-bank me-1"></i> Banks
                </a>
                <a asp-action="Feedbacks" class="btn btn-sm btn-outline-light position-relative">
                    <i class="bi bi-chat-left-dots me-1"></i> Feedback
                    @if (ViewBag.PendingFeedbacks > 0)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                            @ViewBag.PendingFeedbacks
                        </span>
                    }
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container pb-5">
    <!-- Stat Counters -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="cc-surface-card p-3 shadow-sm text-center">
                <div class="small text-muted">Total Cards</div>
                <div class="fw-bold fs-3 text-dark">@ViewBag.TotalCards</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="cc-surface-card p-3 shadow-sm text-center">
                <div class="small text-muted">Active Cards</div>
                <div class="fw-bold fs-3 text-success">@ViewBag.ActiveCards</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="cc-surface-card p-3 shadow-sm text-center">
                <div class="small text-muted">Banks Registered</div>
                <div class="fw-bold fs-3 text-primary">@ViewBag.TotalBanks</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="cc-surface-card p-3 shadow-sm text-center">
                <div class="small text-muted">Customer Accounts</div>
                <div class="fw-bold fs-3 text-info">@ViewBag.TotalUsers</div>
            </div>
        </div>
    </div>

    <!-- Cards Data Table -->
    <div class="cc-surface-card p-4 shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
            <h5 class="fw-bold mb-0 text-dark">All Catalog Cards (@Model.Count)</h5>
            <a asp-action="CreateCard" class="btn btn-sm btn-cc-primary">
                <i class="bi bi-plus-lg me-1"></i> Add Card
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Card Name</th>
                        <th>Bank</th>
                        <th>Category</th>
                        <th>Annual Fee</th>
                        <th>Waiver Spend</th>
                        <th>Status</th>
                        <th>Verified</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @foreach (var card in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@card.Name</div>
                                <span class="text-muted" style="font-size: 0.75rem;">@card.Network.ToString() • Slug: @card.Slug</span>
                            </td>
                            <td>@(card.Bank?.Name ?? "N/A")</td>
                            <td><span class="badge bg-light text-dark border">@card.Category.ToString()</span></td>
                            <td class="fw-bold">@(card.AnnualFee == 0 ? "Free" : "₹" + card.AnnualFee.ToString("N0"))</td>
                            <td class="text-muted">@(card.FeeWaiverSpendThreshold.HasValue ? "₹" + card.FeeWaiverSpendThreshold.Value.ToString("N0") : "None")</td>
                            <td>
                                @if (card.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-muted">@card.SourceVerifiedDate.ToString("dd MMM yyyy")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-controller="Cards" asp-action="Details" asp-route-slug="@card.Slug" target="_blank" class="btn btn-outline-secondary" title="View details page">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="EditCard" asp-route-id="@card.Id" class="btn btn-outline-primary" title="Edit specifications">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="ToggleActive" asp-route-id="@card.Id" method="post" class="d-inline" onsubmit="return confirm('Toggle status for this card?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-warning" title="Toggle active status">
                                            <i class="bi @(card.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                        </button>
                                    </form>
                                    <form asp-action="DeleteCard" asp-route-id="@card.Id" method="post" class="d-inline" onsubmit="return confirm('Permanently delete this card from the database?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger" title="Delete card">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
