@model List<CardCompass.Web.Models.Entities.Bank>
@{
    ViewData["Title"] = "Manage Banks";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-2"><i class="bi bi-arrow-left me-1"></i> Back to Admin</a>
            <h1 class="h3 fw-bold mb-0">Partner Banks & Issuers (@Model.Count)</h1>
        </div>
        <button type="button" class="btn btn-sm btn-cc-primary" data-bs-toggle="modal" data-bs-target="#newBankModal">
            <i class="bi bi-plus-lg me-1"></i> Add Bank
        </button>
    </div>

    <div class="row g-4">
        @foreach (var bank in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="cc-surface-card p-4 h-100 shadow-sm">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="p-3 rounded-circle text-white fs-4" style="background-color: @bank.PrimaryColor; width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-bank"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0 text-dark">@bank.Name</h5>
                            <span class="badge bg-light text-dark border">Code: @bank.Code</span>
                        </div>
                    </div>

                    <div class="small text-muted mb-2">
                        <strong>Cards in Catalog:</strong> @bank.Cards.Count cards
                    </div>
                    <div class="small text-muted mb-2">
                        <strong>Customer Care:</strong> @bank.CustomerCareNumber
                    </div>
                    <div class="small text-muted mb-3">
                        <strong>Official Portal:</strong> <a href="@bank.WebsiteUrl" target="_blank" rel="noopener">@bank.WebsiteUrl</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal: New Bank -->
<div class="modal fade" id="newBankModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <form asp-action="CreateBank" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add Issuing Bank</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Bank Name</label>
                        <input type="text" name="Name" class="form-control" placeholder="e.g. Kotak Mahindra Bank" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Bank Code (Unique)</label>
                        <input type="text" name="Code" class="form-control" placeholder="e.g. KOTAK" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Website URL</label>
                        <input type="url" name="WebsiteUrl" class="form-control" placeholder="https://www.kotak.com" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Customer Care Number</label>
                        <input type="text" name="CustomerCareNumber" class="form-control" placeholder="1860 266 2666" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Brand Primary Color (HEX)</label>
                        <input type="text" name="PrimaryColor" class="form-control" value="#0F2744" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-cc-primary">Save Bank</button>
                </div>
            </form>
        </div>
    </div>
</div>
