@model CardCompass.Web.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="cc-surface-card p-4 p-md-5 shadow-lg">
                <div class="text-center mb-4">
                    <div class="cc-brand-icon mx-auto mb-3">
                        <i class="bi bi-compass-fill"></i>
                    </div>
                    <h2 class="h3 fw-bold mb-1">Welcome Back</h2>
                    <p class="text-muted small">Access your personal card portfolio & rewards ledger</p>
                </div>

                <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-envelope text-muted"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" autofocus required />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-semibold">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-lock text-muted"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" required />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check small">
                            <input class="form-check-input" type="checkbox" asp-for="RememberMe" id="chkRemember">
                            <label class="form-check-label text-muted" for="chkRemember">
                                Remember me for 30 days
                            </label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-cc-primary w-100 py-2 mb-3">
                        Sign In <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </form>

                <div class="text-center pt-3 border-top small text-muted">
                    Don't have an account yet? <a asp-action="Register" asp-route-returnurl="@ViewData["ReturnUrl"]" class="fw-bold">Create free account</a>
                </div>

                <!-- Admin Test Credentials Tip for Development -->
                <div class="mt-4 p-3 bg-light rounded small text-muted">
                    <strong class="text-dark d-block mb-1"><i class="bi bi-shield-lock me-1 text-primary"></i> Admin Access:</strong>
                    <span>Email: <code>admin@cardcompass.in</code><br />Password: <code>CardCompass@Admin2026!</code></span>
                </div>
            </div>
        </div>
    </div>
</div>
