@model CardCompass.Web.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Free Account";
}

<div class="container py-5 my-md-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8 col-sm-10">
            <div class="cc-surface-card p-4 p-md-5 shadow-lg border-0 rounded-4">
                <!-- Brand Header -->
                <div class="text-center mb-4">
                    <div class="cc-brand-icon mx-auto mb-3 shadow-sm" style="width: 52px; height: 52px; font-size: 1.5rem;">
                        <i class="bi bi-compass-fill"></i>
                    </div>
                    <h2 class="h3 fw-bold mb-1 font-heading text-dark">Create Free Account</h2>
                    <p class="text-muted small">Track your credit card portfolio, monitor reward points & log expenses</p>
                </div>



                <form asp-action="Register" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label small fw-semibold text-dark">Full Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-person"></i></span>
                            <input asp-for="FullName" class="form-control border-start-0 ps-0" placeholder="Aarav Sharma" required />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold text-dark">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="name@example.com" required />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="Password" class="form-label small fw-semibold text-dark">Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                                <input asp-for="Password" type="password" class="form-control border-start-0 ps-0" placeholder="Min. 6 chars" required />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-dark">Confirm Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-shield-check"></i></span>
                                <input asp-for="ConfirmPassword" type="password" class="form-control border-start-0 ps-0" placeholder="Repeat password" required />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="MonthlyIncome" class="form-label small fw-semibold text-dark">Monthly Income (₹) <span class="text-muted small">(Optional)</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted">₹</span>
                                <input asp-for="MonthlyIncome" class="form-control border-start-0 ps-0" placeholder="75,000" />
                            </div>
                            <span asp-validation-for="MonthlyIncome" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Occupation" class="form-label small fw-semibold text-dark">Occupation <span class="text-muted small">(Optional)</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-briefcase"></i></span>
                                <input asp-for="Occupation" class="form-control border-start-0 ps-0" placeholder="e.g. Software Engineer" />
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-cc-emerald w-100 py-2 mb-3 rounded-3 shadow-sm fw-semibold">
                        Create Free Account <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </form>

                <!-- Footer Switch -->
                <div class="text-center pt-3 border-top small text-muted">
                    Already have an account? <a asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" class="fw-bold text-decoration-none text-teal">Sign In here</a>
                </div>

                <!-- Security Assurance Badges -->
                <div class="mt-4 pt-3 border-top text-center">
                    <div class="d-flex justify-content-center align-items-center gap-3 text-muted small">
                        <span class="d-flex align-items-center gap-1">
                            <i class="bi bi-shield-lock-fill text-success"></i> 256-bit SSL
                        </span>
                        <span>•</span>
                        <span class="d-flex align-items-center gap-1">
                            <i class="bi bi-check-circle-fill text-teal"></i> RBI Compliant
                        </span>
                        <span>•</span>
                        <span class="d-flex align-items-center gap-1">
                            <i class="bi bi-safe2-fill text-primary"></i> Zero Card Data
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
