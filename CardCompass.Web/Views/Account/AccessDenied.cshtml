@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="max-w-600 mx-auto cc-surface-card p-5 shadow-sm">
        <div class="display-1 text-danger mb-3"><i class="bi bi-shield-lock-fill"></i></div>
        <h1 class="h3 fw-bold mb-2">Access Denied</h1>
        <p class="text-muted small mb-4">
            You do not have the required permissions or administrator role to access this area.
        </p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-cc-primary">
            Return to Homepage
        </a>
    </div>
</div>
