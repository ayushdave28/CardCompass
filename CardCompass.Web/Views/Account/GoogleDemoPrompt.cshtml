@{
    ViewData["Title"] = "Sign in with Google";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="cc-surface-card p-4 p-md-5 shadow-lg border-0 rounded-4">
                <!-- Google Branding -->
                <div class="text-center mb-4">
                    <div class="mb-3">
                        <svg width="48" height="48" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                        </svg>
                    </div>
                    <h2 class="h4 fw-bold mb-1 text-dark">Sign in with Google</h2>
                    <p class="text-muted small">to continue to <strong>CardCompass</strong></p>
                </div>

                <div class="p-3 bg-light rounded-3 mb-4 border d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="width: 44px; height: 44px; font-size: 1.2rem;">
                        G
                    </div>
                    <div class="flex-grow-1 overflow-hidden">
                        <div class="fw-semibold text-dark text-truncate">Google Account</div>
                        <div class="small text-muted text-truncate">Secure OAuth 2.0 Integration</div>
                    </div>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                        <i class="bi bi-shield-check"></i> Verified
                    </span>
                </div>

                <form asp-action="GoogleDemoLoginConfirm" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Google Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-envelope text-muted"></i></span>
                            <input type="email" name="email" class="form-control" value="manish.sharma@gmail.com" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-semibold text-dark">Google Display Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-person text-muted"></i></span>
                            <input type="text" name="fullName" class="form-control" value="Manish Sharma" required />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2 mb-3 shadow-sm" style="background-color: #1a73e8; border-color: #1a73e8;">
                        <i class="bi bi-box-arrow-in-right"></i> Authorize & Continue with Google
                    </button>
                </form>

                <div class="text-center pt-3 border-top">
                    <a asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" class="btn btn-sm btn-link text-decoration-none text-muted">
                        <i class="bi bi-arrow-left me-1"></i> Back to Standard Login
                    </a>
                </div>

                <div class="mt-4 p-3 bg-light rounded small text-muted border-start border-3 border-info">
                    <i class="bi bi-info-circle me-1 text-info"></i>
                    <strong>Production Google OAuth Note:</strong>
                    When ready for production Google Cloud OAuth, simply supply your <code>ClientId</code> and <code>ClientSecret</code> in <code>appsettings.json</code> under <code>Authentication:Google</code>. The app automatically connects directly to Google's live identity servers!
                </div>
            </div>
        </div>
    </div>
</div>
