@model CardCompass.Web.Models.Entities.Feedback
@{
    ViewData["Title"] = "Contact & Feedback";
}

<div class="container py-5">
    <div class="row g-5 max-w-900 mx-auto">
        <div class="col-lg-5">
            <span class="badge bg-primary bg-opacity-10 text-primary fw-bold px-3 py-1 mb-2">Get in Touch</span>
            <h1 class="h2 fw-bold mb-3">CardCompass Research Team</h1>
            <p class="text-muted mb-4">
                Have a correction for a credit card's terms, a suggestion for a card to add, or general feedback on our calculators? We welcome your input.
            </p>

            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="p-2 rounded bg-light text-primary fs-5"><i class="bi bi-envelope"></i></div>
                <div>
                    <div class="small text-muted">Email Editorial</div>
                    <div class="fw-bold">editorial@cardcompass.in</div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="p-2 rounded bg-light text-primary fs-5"><i class="bi bi-geo-alt"></i></div>
                <div>
                    <div class="small text-muted">Location</div>
                    <div class="fw-bold">Bengaluru, Karnataka, India</div>
                </div>
            </div>

            <div class="p-3 bg-light rounded text-muted small">
                <i class="bi bi-info-circle me-1 text-primary"></i> Submissions are reviewed by our financial analysts and administrators in the Admin Console.
            </div>
        </div>

        <div class="col-lg-7">
            <div class="cc-surface-card p-4 shadow-sm">
                <h4 class="h5 fw-bold mb-3 text-dark">Send Feedback or Suggestion</h4>

                <form asp-action="Contact" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label small fw-semibold">Your Name</label>
                        <input asp-for="Name" class="form-control" placeholder="Enter your name" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold">Email Address</label>
                        <input asp-for="Email" class="form-control" placeholder="you@example.com" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Subject" class="form-label small fw-semibold">Subject / Card Reference</label>
                        <input asp-for="Subject" class="form-control" placeholder="e.g. Rate update for HDFC Millennia" required />
                        <span asp-validation-for="Subject" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Message" class="form-label small fw-semibold">Your Message</label>
                        <textarea asp-for="Message" class="form-control" rows="5" placeholder="Share your suggestions, card corrections, or feedback..." required></textarea>
                        <span asp-validation-for="Message" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-cc-primary w-100 py-2">
                        Submit Feedback <i class="bi bi-send ms-1"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
