                        <span class="badge bg-success-subtle text-success">Verified Rates</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-muted">Monthly Spending: Online Shopping</label>
                        <div class="fw-bold fs-5 text-dark">₹15,000 / month</div>
                    </div>

                    <div class="list-group list-group-flush mb-3">
