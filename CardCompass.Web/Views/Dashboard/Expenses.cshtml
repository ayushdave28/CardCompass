@model CardCompass.Web.Models.ViewModels.UserDashboardViewModel
@{
    ViewData["Title"] = "Expense & Reward Ledger";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-2"><i class="bi bi-arrow-left me-1"></i> Dashboard Overview</a>
            <h1 class="h3 fw-bold mb-0">Expense & Rewards Ledger</h1>
            <p class="text-muted small mb-0">Record your purchases to see exact rewards earned per card and category</p>
        </div>
        <button type="button" class="btn btn-sm btn-cc-primary" data-bs-toggle="modal" data-bs-target="#newExpenseModal">
            <i class="bi bi-plus-lg me-1"></i> Record Purchase
        </button>
    </div>

    <!-- Summary Metrics -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="cc-surface-card p-3 shadow-sm text-center">
                <div class="small text-muted">Total Recorded Expenses</div>
                <div class="fw-bold fs-3 text-dark">₹@Model.TotalMonthlyExpenses.ToString("N0")</div>
                <div class="small text-muted">Current Calendar Month</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="cc-surface-card p-3 shadow-sm text-center">
                <div class="small text-muted">Estimated Rewards Earned</div>
                <div class="fw-bold fs-3 text-success">₹@Model.TotalMonthlyRewardsEarned.ToString("N0")</div>
                <div class="small text-muted">Cashback & Points Value</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="cc-surface-card p-3 shadow-sm text-center">
                <div class="small text-muted">Effective Portfolio Yield</div>
                <div class="fw-bold fs-3 text-primary">
                    @(Model.TotalMonthlyExpenses > 0 ? ((Model.TotalMonthlyRewardsEarned / Model.TotalMonthlyExpenses) * 100m).ToString("0.##") + "%" : "0.0%")
                </div>
                <div class="small text-muted">Blended Return Rate</div>
            </div>
        </div>
    </div>

    <!-- Expenses Ledger Table -->
    <div class="cc-surface-card p-4 shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
            <h5 class="fw-bold mb-0 text-dark">Transaction History (@Model.RecentExpenses.Count)</h5>
            <button type="button" class="btn btn-sm btn-cc-emerald" data-bs-toggle="modal" data-bs-target="#newExpenseModal">
                <i class="bi bi-plus-lg me-1"></i> Log Transaction
            </button>
        </div>

        @if (!Model.RecentExpenses.Any())
        {
            <div class="p-5 text-center bg-light rounded my-3">
                <div class="display-4 text-muted mb-3"><i class="bi bi-receipt"></i></div>
                <h5 class="fw-bold text-dark">No expenses recorded yet</h5>
                <p class="small text-muted mb-4" style="max-width: 450px; margin: 0 auto;">
                    Record your recent credit card swipes to track monthly spending and compute exact cashback and points earned.
                </p>
                <button type="button" class="btn btn-cc-primary" data-bs-toggle="modal" data-bs-target="#newExpenseModal">
                    <i class="bi bi-plus-lg me-1"></i> Record Your First Expense
                </button>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Date</th>
                            <th>Merchant</th>
                            <th>Category</th>
                            <th>Card Used</th>
                            <th class="text-end">Amount (₹)</th>
                            <th class="text-end">Reward Earned</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @foreach (var exp in Model.RecentExpenses)
                        {
                            <tr>
                                <td>@exp.Date.ToString("dd MMM yyyy")</td>
                                <td class="fw-bold text-dark">@exp.MerchantName</td>
                                <td><span class="badge bg-light text-dark border">@exp.Category.ToString()</span></td>
                                <td class="text-muted">
                                    @(exp.UserCard != null ? $"{exp.UserCard.Nickname} (•••• {exp.UserCard.Last4Digits})" : "Unassigned")
                                </td>
                                <td class="text-end fw-bold text-dark">₹@exp.Amount.ToString("N0")</td>
                                <td class="text-end fw-bold text-success">₹@exp.EstimatedRewardEarned.ToString("N2")</td>
                                <td class="text-end">
                                    <form asp-action="RemoveExpense" asp-route-expenseId="@exp.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this expense record?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-xs btn-outline-danger py-1 px-2" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Modal: Record Expense -->
<div class="modal fade" id="newExpenseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <form asp-action="AddExpense" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Record Credit Card Purchase</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Card Used</label>
                        <select name="UserCardId" class="form-select">
                            <option value="">-- No specific card / General --</option>
                            @foreach (var uc in Model.UserCards)
                            {
                                <option value="@uc.Id">@uc.Nickname (•••• @uc.Last4Digits) — @(uc.CreditCard?.Name)</option>
                            }
                        </select>
                        <span class="small text-muted">Rewards will be calculated according to the selected card's category rules.</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Purchase Amount (₹)</label>
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input type="number" name="Amount" class="form-control" placeholder="e.g. 2500" min="1" step="10" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Merchant / Vendor</label>
                        <input type="text" name="MerchantName" class="form-control" placeholder="e.g. Swiggy, Amazon, Reliance Fresh" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Spending Category</label>
                        <select name="Category" class="form-select">
                            <option value="OnlineShopping">Online Shopping</option>
                            <option value="Dining">Dining & Food Delivery</option>
                            <option value="Grocery">Grocery</option>
                            <option value="Travel">Travel & Flight Booking</option>
                            <option value="Fuel">Fuel</option>
                            <option value="Utilities">Utilities & Bills</option>
                            <option value="UPI">UPI Scan & Pay</option>
                            <option value="International">International</option>
                            <option value="GeneralSpends">General Retail</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Date of Transaction</label>
                        <input type="date" name="Date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Notes (Optional)</label>
                        <input type="text" name="Notes" class="form-control" placeholder="e.g. Birthday dinner with family" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-cc-primary">Log Expense</button>
                </div>
            </form>
        </div>
    </div>
</div>
