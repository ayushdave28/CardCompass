@model CardCompass.Web.Models.ViewModels.UserDashboardViewModel
@{
    ViewData["Title"] = "Customer Dashboard";
    var user = Model.User;
}

<div class="bg-dark text-white py-4 border-bottom mb-4" style="background: linear-gradient(135deg, #0A192F 0%, #152A4A 100%);">
    <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <span class="badge bg-primary bg-opacity-25 text-info px-3 py-1 mb-2">Customer Financial Center</span>
                <h1 class="h3 fw-bold mb-1">Hello, @(user.FullName ?? user.UserName)!</h1>
                <p class="text-white-50 small mb-0">Track your credit card portfolio, reward balances, bill payment dates, and expenses</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Wallet" class="btn btn-sm btn-cc-primary">
                    <i class="bi bi-wallet2 me-1"></i> My Wallet (@Model.UserCards.Count)
                </a>
                <a asp-action="Expenses" class="btn btn-sm btn-cc-emerald">
                    <i class="bi bi-plus-circle me-1"></i> Log Expense
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container pb-5">
    <!-- Stat Metrics Row -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="cc-surface-card p-3 shadow-sm text-center">
                <div class="small text-muted">Wallet Cards</div>
                <div class="fw-bold fs-3 text-dark">@Model.UserCards.Count</div>
                <div class="small text-muted">Active in Portfolio</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="cc-surface-card p-3 shadow-sm text-center">
                <div class="small text-muted">Reward Points Value</div>
                <div class="fw-bold fs-3 text-success">₹@Model.TotalRewardPointsValue.ToString("N0")</div>
                <div class="small text-muted">Estimated Real Value</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="cc-surface-card p-3 shadow-sm text-center">
                <div class="small text-muted">Monthly Recorded Spends</div>
                <div class="fw-bold fs-3 text-primary">₹@Model.TotalMonthlyExpenses.ToString("N0")</div>
                <div class="small text-muted">Current Month Ledger</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="cc-surface-card p-3 shadow-sm text-center">
                <div class="small text-muted">Rewards Earned This Month</div>
                <div class="fw-bold fs-3 text-warning">₹@Model.TotalMonthlyRewardsEarned.ToString("N0")</div>
                <div class="small text-muted">Calculated on Spends</div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- Left: Upcoming Bill Payment Dates & Wallet Quick Look -->
        <div class="col-lg-7">
            <div class="cc-surface-card p-4 shadow-sm mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-calendar-event me-2 text-primary"></i> Card Bill Due Dates & Schedule</h5>
                    <a asp-action="Wallet" class="small text-primary text-decoration-none">Manage Wallet</a>
                </div>

                @if (!Model.UserCards.Any())
                {
                    <div class="p-4 text-center bg-light rounded">
                        <i class="bi bi-wallet2 fs-2 text-muted mb-2 d-block"></i>
                        <h6 class="fw-bold text-dark">No cards added to your wallet yet</h6>
                        <p class="small text-muted mb-3">Add the cards you currently own to keep track of billing cycles, payment due dates, and reward balances.</p>
                        <a asp-action="Wallet" class="btn btn-sm btn-cc-primary">
                            <i class="bi bi-plus-lg me-1"></i> Add Your First Card
                        </a>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var uc in Model.UserCards)
                        {
                            var today = DateTime.Today.Day;
                            var daysLeft = uc.PaymentDueDay >= today ? uc.PaymentDueDay - today : (30 - today + uc.PaymentDueDay);

                            <div class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="p-2 rounded bg-primary bg-opacity-10 text-primary">
                                        <i class="bi bi-credit-card fs-4"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@uc.Nickname <span class="badge bg-light text-muted border">•••• @uc.Last4Digits</span></div>
                                        <div class="small text-muted">@(uc.CreditCard?.Name) • Statement: @uc.BillingCycleDay th of month</div>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <span class="badge @(daysLeft <= 5 ? "bg-danger" : "bg-primary") px-2 py-1">
                                        Due in @daysLeft days
                                    </span>
                                    <div class="small text-muted mt-1">Due Date: @uc.PaymentDueDay th</div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Saved Comparisons -->
            <div class="cc-surface-card p-4 shadow-sm">
                <h5 class="fw-bold mb-3 pb-2 border-bottom text-dark"><i class="bi bi-layout-split me-2 text-primary"></i> Saved Side-by-Side Comparisons</h5>

                @if (!Model.SavedComparisons.Any())
                {
                    <div class="p-3 text-center bg-light rounded small text-muted">
                        No saved comparisons yet. When comparing cards in the Compare tool, click <strong>Save Comparison</strong> to pin them here.
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var comp in Model.SavedComparisons)
                        {
                            var cardIds = System.Text.Json.JsonSerializer.Deserialize<List<int>>(comp.CardIdsJson) ?? new List<int>();
                            <div class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-bold text-dark">@comp.Title</div>
                                    <div class="small text-muted">Saved on @comp.CreatedAt.ToString("dd MMM yyyy")</div>
                                </div>
                                <div class="d-flex gap-2">
                                    <a href="/Compare?ids=@string.Join(",", cardIds)" class="btn btn-sm btn-outline-primary">
                                        Open Matrix <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                    <form asp-action="RemoveComparison" asp-route-comparisonId="@comp.Id" method="post" class="d-inline" onsubmit="return confirm('Remove saved comparison?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Right: Category Spending Breakdown Chart -->
        <div class="col-lg-5">
            <div class="cc-surface-card p-4 shadow-sm mb-4">
                <h5 class="fw-bold mb-3 pb-2 border-bottom text-dark"><i class="bi bi-pie-chart me-2 text-primary"></i> Current Month Spending Breakdown</h5>

                @if (Model.SpendingByCategory.Any())
                {
                    <div style="max-height: 260px;" class="mb-3 d-flex justify-content-center">
                        <canvas id="spendingChart"></canvas>
                    </div>

                    <div class="small text-muted">
                        @foreach (var kv in Model.SpendingByCategory)
                        {
                            <div class="d-flex justify-content-between py-1 border-bottom">
                                <span>@kv.Key.ToString()</span>
                                <strong class="text-dark">₹@kv.Value.ToString("N0")</strong>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="p-4 text-center bg-light rounded">
                        <i class="bi bi-receipt fs-2 text-muted mb-2 d-block"></i>
                        <h6 class="fw-bold text-dark">No expenses recorded this month</h6>
                        <p class="small text-muted mb-3">Record transactions to visualize your spending distribution and automatically track rewards earned.</p>
                        <a asp-action="Expenses" class="btn btn-sm btn-cc-emerald">
                            <i class="bi bi-plus-lg me-1"></i> Record An Expense
                        </a>
                    </div>
                }
            </div>

            <!-- Saved Favorites -->
            <div class="cc-surface-card p-4 shadow-sm">
                <h5 class="fw-bold mb-3 pb-2 border-bottom text-dark"><i class="bi bi-heart me-2 text-danger"></i> Favorite Cards Watchlist</h5>

                @if (!Model.FavoriteCards.Any())
                {
                    <div class="p-3 text-center bg-light rounded small text-muted">
                        No favorite cards saved. Tap the <i class="bi bi-heart text-danger"></i> icon on any card in the directory to save it to your watchlist.
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var fav in Model.FavoriteCards)
                        {
                            <div class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-bold text-dark">@fav.Name</div>
                                    <div class="small text-muted">@(fav.Bank?.Name) • @(fav.AnnualFee == 0 ? "Lifetime Free" : "Fee: ₹" + fav.AnnualFee.ToString("N0"))</div>
                                </div>
                                <a asp-controller="Cards" asp-action="Details" asp-route-slug="@fav.Slug" class="btn btn-xs btn-outline-secondary py-1 px-2">
                                    View
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.SpendingByCategory.Any())
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const ctx = document.getElementById('spendingChart');
                if (ctx) {
                    const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SpendingByCategory.Keys.Select(k => k.ToString())));
                    const data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SpendingByCategory.Values));

                    new Chart(ctx, {
                        type: 'doughnut',
                        data: {
                            labels: labels,
                            datasets: [{
                                data: data,
                                backgroundColor: [
                                    '#00B4D8', '#10B981', '#F59E0B', '#F43F5E', '#8B5CF6', '#38BDF8', '#64748B'
                                ],
                                borderWidth: 0
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    position: 'bottom',
                                    labels: { boxWidth: 12, font: { size: 11 } }
                                }
                            }
                        }
                    });
                }
            });
        </script>
    }
}
