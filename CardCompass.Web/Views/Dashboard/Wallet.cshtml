@model CardCompass.Web.Models.ViewModels.UserDashboardViewModel
@{
    ViewData["Title"] = "My Card Wallet";
    var availableCards = ViewBag.AvailableCards as List<CardCompass.Web.Models.Entities.CreditCard> ?? new List<CardCompass.Web.Models.Entities.CreditCard>();
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-2"><i class="bi bi-arrow-left me-1"></i> Dashboard Overview</a>
            <h1 class="h3 fw-bold mb-0">My Credit Card Wallet (@Model.UserCards.Count)</h1>
        </div>
        <button type="button" class="btn btn-sm btn-cc-primary" data-bs-toggle="modal" data-bs-target="#addCardWalletModal">
            <i class="bi bi-plus-lg me-1"></i> Add Card to Wallet
        </button>
    </div>

    @if (!Model.UserCards.Any())
    {
        <div class="cc-surface-card p-5 text-center shadow-sm">
            <div class="display-3 text-muted mb-3"><i class="bi bi-wallet2"></i></div>
            <h3 class="h4 fw-bold mb-2">Your Wallet is Empty</h3>
            <p class="text-muted small mb-4" style="max-width: 480px; margin: 0 auto;">
                Add the credit cards you currently own. Track your reward balances, keep track of payment due dates, and test transactions in the Purchase Advisor.
            </p>
            <button type="button" class="btn btn-cc-primary" data-bs-toggle="modal" data-bs-target="#addCardWalletModal">
                <i class="bi bi-plus-lg me-1"></i> Add Your First Card
            </button>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var uc in Model.UserCards)
            {
                var card = uc.CreditCard;
                var balance = uc.RewardBalances.FirstOrDefault();

                <div class="col-md-6 col-lg-4">
                    <div class="cc-surface-card p-4 h-100 shadow-sm d-flex flex-column justify-content-between">
                        <div>
                            <!-- Card Visual -->
                            @if (card != null)
                            {
                                <div class="cc-card-art w-100 mb-3" style="background: @card.CardGradient; aspect-ratio: 1.586;">
                                    <div class="cc-card-top">
                                        <div class="cc-card-bank"><i class="bi bi-bank"></i> @(card.Bank?.Name)</div>
                                        <div class="cc-contactless-icon"><i class="bi bi-reception-4"></i></div>
                                    </div>
                                    <div class="cc-card-middle">
                                        <div class="cc-emv-chip @(card.ChipColor == "silver" ? "silver" : "")"></div>
                                        <span class="badge bg-light text-dark fw-bold small">•••• @uc.Last4Digits</span>
                                    </div>
                                    <div class="cc-card-bottom">
                                        <div>
                                            <div class="cc-card-tier">@uc.Nickname</div>
                                            <div class="cc-card-name small">@card.Name</div>
                                        </div>
                                        <div class="cc-network-badge">@card.Network.ToString()</div>
                                    </div>
                                </div>
                            }

                            <h5 class="fw-bold mb-1 text-dark">@uc.Nickname</h5>
                            <div class="small text-muted mb-3">@(card?.Name) • Added @uc.AddedDate.ToString("MMM yyyy")</div>

                            <!-- Due Dates Box -->
                            <div class="p-3 bg-light rounded mb-3">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-muted">Billing Cycle Date:</span>
                                    <strong class="text-dark">@uc.BillingCycleDay th of month</strong>
                                </div>
                                <div class="d-flex justify-content-between small">
                                    <span class="text-muted">Payment Due Date:</span>
                                    <strong class="text-primary">@uc.PaymentDueDay th of month</strong>
                                </div>
                            </div>

                            <!-- Reward Balance Box -->
                            <div class="p-3 bg-light rounded mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="small text-muted">Reward Points:</span>
                                    <span class="fw-bold text-success fs-5">@(balance?.PointsBalance.ToString("N0") ?? "0")</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center small text-muted">
                                    <span>Est. Rupee Value:</span>
                                    <strong class="text-dark">₹@(balance?.EstimatedRupeeValue.ToString("N0") ?? "0")</strong>
                                </div>
                                @if (balance?.ExpiryDate.HasValue == true)
                                {
                                    <div class="d-flex justify-content-between align-items-center small text-danger mt-1">
                                        <span>Expiry Date:</span>
                                        <span>@balance.ExpiryDate.Value.ToString("dd MMM yyyy")</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="d-flex gap-2 pt-3 border-top mt-2">
                            <button type="button" class="btn btn-sm btn-outline-primary flex-grow-1" data-bs-toggle="modal" data-bs-target="#editBalanceModal-@uc.Id">
                                <i class="bi bi-pencil me-1"></i> Update Points
                            </button>
                            <form asp-action="RemoveCard" asp-route-userCardId="@uc.Id" method="post" onsubmit="return confirm('Remove this card from your wallet?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove card">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Modal: Update Balance for this card -->
                <div class="modal fade" id="editBalanceModal-@uc.Id" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow-lg">
                            <form asp-action="UpdateBalance" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="UserCardId" value="@uc.Id" />
                                <div class="modal-header">
                                    <h5 class="modal-title fw-bold">Update Points: @uc.Nickname</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body p-4">
                                    <div class="mb-3">
                                        <label class="form-label small fw-semibold">Reward Program Name</label>
                                        <input type="text" name="ProgramName" class="form-control" value="@(balance?.ProgramName ?? $"{card?.Name} Rewards")" required />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small fw-semibold">Current Points Balance</label>
                                        <input type="number" name="PointsBalance" class="form-control" value="@(balance?.PointsBalance ?? 0)" step="1" required />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small fw-semibold">Estimated Rupee Value (₹) (Optional)</label>
                                        <input type="number" name="EstimatedRupeeValue" class="form-control" value="@(balance?.EstimatedRupeeValue ?? 0)" step="1" />
                                        <span class="text-muted small">Auto-calculated using card's redemption multiplier if left 0.</span>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small fw-semibold">Points Expiry Date (Optional)</label>
                                        <input type="date" name="ExpiryDate" class="form-control" value="@(balance?.ExpiryDate?.ToString("yyyy-MM-dd"))" />
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-cc-primary">Save Balance</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Modal: Add Card to Wallet -->
<div class="modal fade" id="addCardWalletModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <form asp-action="AddCard" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add Credit Card to Wallet</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Select Credit Card</label>
                        <select name="CreditCardId" class="form-select" required>
                            <option value="">-- Choose from 30 Catalog Cards --</option>
                            @foreach (var c in availableCards)
                            {
                                <option value="@c.Id">@c.Bank?.Name — @c.Name (@c.Category.ToString())</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Card Nickname</label>
                        <input type="text" name="Nickname" class="form-control" placeholder="e.g. My Daily Driver" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Last 4 Digits</label>
                        <input type="text" name="Last4Digits" class="form-control" placeholder="1234" maxlength="4" minlength="4" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Billing Statement Day</label>
                            <input type="number" name="BillingCycleDay" class="form-control" value="15" min="1" max="31" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Payment Due Day</label>
                            <input type="number" name="PaymentDueDay" class="form-control" value="5" min="1" max="31" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Assigned Credit Limit (₹) (Optional)</label>
                        <input type="number" name="CreditLimit" class="form-control" placeholder="e.g. 250000" step="5000" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-cc-primary">Add Card</button>
                </div>
            </form>
        </div>
    </div>
</div>
